# 복사해서 .env 로 만든 뒤 값을 채웁니다. 실제 값은 절대 Git 에 올리지 않습니다.

NODE_ENV=development
PORT=4000

# PostgreSQL 연결 주소 (Render 의 External Database URL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# 이 앱 전용 스키마 (같은 DB 를 다른 과제와 나눠 쓸 때 섞이지 않게 함)
DATABASE_SCHEMA=testory
# 비워 두면 localhost 가 아닌 주소에서는 자동으로 SSL 을 켭니다. (true/false)
DATABASE_SSL=

# 로그인 토큰 서명 비밀값 (16자 이상 랜덤 문자열)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# 허용할 프론트엔드 주소 (쉼표로 여러 개)
FRONTEND_URL=http://localhost:3000

# AI 분석 (비워 두면 AI 분석 실행만 막히고 저장된 분석 조회는 됩니다)
GPT_API_KEY=
GPT_MODEL=gpt-4o-mini
GPT_SEARCH_MODEL=gpt-4.1-mini

# 시연 데이터 (운영에서는 DEMO_SEED_ENABLED=true 이고 DEMO_PASSWORD 를 직접 정해야만 동작)
DEMO_SEED_ENABLED=false
DEMO_PASSWORD=
