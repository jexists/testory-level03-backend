# 서버 포트 (Render 는 자동으로 PORT 를 넣어 준다)
PORT=4000
# PostgreSQL 연결 주소 (필수)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME
# 로그인 토큰 서명용 비밀 문자열, 길고 무작위로 (필수)
JWT_SECRET=change-me
# 접속을 허용할 프론트엔드 주소, 여러 개면 쉼표로 구분
FRONTEND_ORIGIN=http://localhost:3000
# GPT API 키 (AI 분석 버튼에만 필요, 비워 두면 분석만 실패 안내가 나온다)
GPT_API_KEY=
# 분석에 쓸 GPT 모델 이름
GPT_MODEL=gpt-4o-mini
